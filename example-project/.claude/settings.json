{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "my-marketplace": {
      "source": {
        "source": "github",
        "repo": "easingthemes/ai-plugins-example"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "my-first-plugin@my-marketplace": true
  },
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(ls:*)",
      "Bash(cat:*)"
    ]
  }
}
